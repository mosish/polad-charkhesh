# Edit server_name and certificate paths to match the domains you control.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl http2 default_server;
    ssl_reject_handshake on;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name poladcharkhesh.com poladcharkhesh.ir;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name poladcharkhesh.com poladcharkhesh.ir;
    ssl_certificate /etc/letsencrypt/live/REPLACE_WITH_CERTIFICATE_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_CERTIFICATE_NAME/privkey.pem;
    client_max_body_size 12m;
    ssl_protocols TLSv1.2 TLSv1.3;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json application/xml image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
