# Edit server_name and certificate paths to match the domains you control.
server {
    listen 80;
    server_name poladcharkhesh.com poladcharkhesh.ir;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name poladcharkhesh.com poladcharkhesh.ir;
    ssl_certificate /etc/letsencrypt/live/REPLACE_WITH_CERTIFICATE_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_CERTIFICATE_NAME/privkey.pem;
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
