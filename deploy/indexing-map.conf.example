# Install in /etc/nginx/conf.d/polad-indexing.conf (http context).
# Node's explicit ENABLE_SEARCH_INDEXING flag is the single source of truth.
# Missing upstream headers fail closed, including proxy errors.
map $upstream_http_x_robots_tag $polad_robots {
    default "noindex, nofollow";
    "index, follow" "index, follow";
}
# In each proxied website server block, replace hardcoded X-Robots-Tag with:
# proxy_hide_header X-Robots-Tag;
# add_header X-Robots-Tag $polad_robots always;
# Keep ENABLE_SEARCH_INDEXING=false until owner and engineering approval.
