# Prepared English-domain layout. Enable only after polad-com is issued.
# Keep the existing IP and Persian-domain vhosts.
server {
    listen 80;
    listen [::]:80;
    server_name poladcharkhesh.com www.poladcharkhesh.com;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name www.poladcharkhesh.com;
    ssl_certificate /etc/letsencrypt/live/polad-com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/polad-com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    return 301 https://poladcharkhesh.com$request_uri;
}
server {
    listen 443 ssl http2;
    server_name poladcharkhesh.com;
    ssl_certificate /etc/letsencrypt/live/polad-com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/polad-com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 12m;
    add_header X-Robots-Tag "noindex, nofollow" always;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json application/xml image/svg+xml;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
