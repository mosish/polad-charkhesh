# Temporary certificate bootstrap. Replace this with nginx.conf.example after issuance.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name poladcharkhesh.com poladcharkhesh.ir;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 503; }
}
