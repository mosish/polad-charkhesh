{
  "name": "polad-charkhesh-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build --config vite.vps.config.ts && esbuild api/index.ts api/media-worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js",
    "lint": "oxlint --tsconfig tsconfig.platform.json",
    "format": "oxfmt",
    "dev:web": "vite --config vite.vps.config.ts",
    "dev:api": "tsx watch api/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.platform.json",
    "test": "tsx --test tests/*.test.ts",
    "audit:catalog": "tsx scripts/catalog-audit.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "backup:data": "tsx scripts/backup-data.ts",
    "verify:backup": "tsx scripts/verify-backup.ts",
    "check:hosting": "node scripts/hosting-check.mjs",
    "audit:seo": "tsx scripts/seo-audit.ts",
    "check:bundles": "node scripts/check-bundles.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cookie-parser": "1.4.7",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "input-otp": "1.4.2",
    "jose": "6.2.12",
    "jspdf": "4.2.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "three-webgl1": "npm:three@0.162.0",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@types/three-webgl1": "npm:@types/three@0.162.0",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "type": "module"
}
