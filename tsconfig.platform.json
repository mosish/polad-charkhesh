{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowArbitraryExtensions": true
  },
  "include": [
    "app/main.tsx",
    "app/Router.tsx",
    "components/platform/**/*.tsx",
    "components/admin/**/*.tsx",
    "lib/api.ts",
    "lib/engineering.ts",
    "api/**/*.ts",
    "scripts/dev.ts",
    "tests/**/*.ts",
    "scripts/build-catalog-review.ts",
    "scripts/build-catalog-media.ts",
    "scripts/audit-engineering-foundation.ts",
    "app/layout.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
