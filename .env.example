NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Production: each secret needs at least 32 characters; use independent random values.
# SETUP_TOKEN needs at least 24 characters until the first administrator exists.
# Production DATABASE_PATH and UPLOAD_DIR must be absolute persistent paths.
SESSION_SECRET=
COOKIE_SECRET=
# Production defaults to required MFA. Generate a separate key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# MFA_REQUIRED=false is for isolated non-MFA tests only, not live deployments.
# Optional origin validation when Cloudflare Access protects the admin portal:
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_AUDIENCE=
# Keep false until explicit owner authorization AND engineering acceptance.
ENABLE_SEARCH_INDEXING=false
# PDF uploads fail closed unless qpdf >= 11 is installed.
# QPDF_PATH=/usr/bin/qpdf
SETUP_TOKEN=
DATABASE_PATH=./data/platform.sqlite
UPLOAD_DIR=./data/uploads
# Production only: leave unset when restoring existing data. Set to 1 ONLY for
# deliberate first-time initialization, then remove after setup.
# ALLOW_INITIALIZE_DATABASE=1
